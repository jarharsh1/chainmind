# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# Optional dedicated read-only user for the query path (defense in depth).
# Leave blank to fall back to the main credentials above.
NEO4J_READ_USERNAME=
NEO4J_READ_PASSWORD=

# ---- LLM provider (OpenAI-compatible) ----
# Default: Groq. Swap these three for any OpenAI-compatible endpoint:
#   NVIDIA NIM : https://integrate.api.nvidia.com/v1  + meta/llama-3.1-70b-instruct
#   Ollama     : http://localhost:11434/v1            + llama3.1:8b   (LLM_API_KEY can be any non-empty string)
#   OpenAI     : https://api.openai.com/v1            + gpt-4o-mini
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---- Query / API ----
QUERY_TIMEOUT_SECONDS=15
GRAPH_NODE_LIMIT=500
# Comma-separated allowed origins, or * for all (pin to your frontend in prod).
CORS_ORIGINS=*
